{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    // "@/shared/ui" instead of "../../../shared/ui" — and a clear signal of which FSD layer you import.
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "vite.config.ts", "steiger.config.ts"]
}
