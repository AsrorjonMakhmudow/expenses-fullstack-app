{
  "name": "expenses-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "pnpm build:shared && pnpm --filter @expenses/api dev",
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @expenses/shared build",
    "test": "pnpm build:shared && pnpm -r test",
    "test:e2e": "pnpm build:shared && pnpm --filter @expenses/api test:e2e",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm build:shared && pnpm --filter @expenses/api db:generate",
    "db:migrate": "pnpm --filter @expenses/api db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
