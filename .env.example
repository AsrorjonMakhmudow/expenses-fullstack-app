# Copy to .env and change values. .env is git-ignored; this file is the documented template.

# PostgreSQL (docker compose)
POSTGRES_USER=expenses
POSTGRES_PASSWORD=change_me
POSTGRES_DB=expenses

# API
PORT=3000
DATABASE_URL=postgresql://expenses:change_me@localhost:5432/expenses
# Used only by e2e tests — a separate database, so tests never touch real data.
TEST_DATABASE_URL=postgresql://expenses:change_me@localhost:5432/expenses_test

# Auth (ADR 0009). All optional — these are the defaults.
# Signed out after this many days without using the app / after this many days in any case.
SESSION_IDLE_DAYS=14
SESSION_MAX_DAYS=60
# false = nobody new can sign up (existing users still sign in)
REGISTRATION_ENABLED=true
# Where the web app runs; changes coming from any other site are refused (CSRF).
APP_ORIGIN=http://localhost:5173
# Sign-in / sign-up attempts per IP address per 15 minutes
AUTH_RATE_LIMIT=10
